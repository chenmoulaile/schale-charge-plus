<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Halo: the Blue Archive signature. Concentric ring, inner contour wound the
       opposite way so the nonzero fill rule punches the hole out. -->
  <StreamGeometry x:Key="Geo.Halo">M12 1.5 A10.5 10.5 0 1 0 12 22.5 A10.5 10.5 0 1 0 12 1.5 Z M12 4.9 A7.1 7.1 0 1 1 12 19.1 A7.1 7.1 0 1 1 12 4.9 Z</StreamGeometry>
  <StreamGeometry x:Key="Geo.Halo.Small">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 6 A6 6 0 1 1 12 18 A6 6 0 1 1 12 6 Z</StreamGeometry>
</ResourceDictionary>
